        F13["impact_score"]
        F14["exploitability_score"]
    end

    subgraph Model["LambdaMART Model"]
        direction TB
        TREES["Gradient Boosted<br/>Decision Trees"]
        LAMBDA["Lambda Gradient<br/>Optimization"]
        RANK["Pairwise Ranking<br/>Loss Function"]
        TREES --> LAMBDA --> RANK
    end

    subgraph Output["Output"]
        SCORE["Risk Score<br/>(0-100)"]
        RANK_POS["Rank Position"]
        EXPLAIN["Feature<br/>Contributions"]
