# CTI Recommender Environment Variables
# Copy this file to .env and update with your values

# ==============================================================================
# API KEYS
# ==============================================================================

# NVD API Key (optional, but recommended for higher rate limits)
# Get yours at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ==============================================================================
# DATABASE
# ==============================================================================

# SQLite database path (relative to project root)
DATABASE_PATH=data/cve_database.db

# ==============================================================================
# LOGGING
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable structured JSON logging (recommended for production)
STRUCTURED_LOGGING=false

# ==============================================================================
# API SERVER
# ==============================================================================

# FastAPI server configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false  # Set to true in development

# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================

# Use pruned model (recommended for production)
# Set to false to use original 23-feature model
USE_PRUNED_MODEL=true

# ==============================================================================
# PIPELINE CONFIGURATION
# ==============================================================================

# Default number of days to fetch CVEs in incremental updates
DEFAULT_FETCH_DAYS=7

# Save enrichment progress every N batches (for crash recovery)
ENRICHMENT_CHECKPOINT_INTERVAL=50

# ==============================================================================
# MONITORING (Optional)
# ==============================================================================

# Enable Prometheus metrics endpoint
ENABLE_METRICS=false
METRICS_PORT=9090
