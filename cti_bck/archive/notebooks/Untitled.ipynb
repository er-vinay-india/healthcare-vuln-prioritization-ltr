    "import matplotlib.pyplot as plt\n",
    "\n",
    "years = [2020, 2021, 2022, 2023, 2024, 2025]\n",
    "cves = [18375, 20161, 25059, 28961, 40077, 35448]\n",
    "\n",
    "plt.figure(figsize=(8, 4))\n",
    "plt.plot(years, cves, marker=\"o\")\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Number of CVEs\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
